# Public canonical origin, without a trailing slash.
# Replace with the confirmed production domain before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set only for a static mirror hosted below a path such as GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Static mirrors send submissions and readers to this authoritative deployment.
NEXT_PUBLIC_LIVE_ORIGIN=https://veligondastories.netlify.app

# Comma-separated browser origins allowed to submit cross-origin updates.
PUBLIC_SUBMISSION_ORIGINS=https://ai-reddy.github.io
